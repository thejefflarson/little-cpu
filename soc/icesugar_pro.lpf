// Pin constraints for soc/board_icesugar_pro.v on a MuseLab iCESugar-Pro:
// ECP5 LFE5U-25F, caBGA256, speed grade 6.
//
// Pins are the board's own, cross-checked against litex-boards'
// muselab_icesugar_pro platform rather than guessed. The RGB LED's colour
// order is the part that is easy to get wrong and the board's README does not
// state it: {A11, A12, B11} is GREEN, BLUE, RED, not the order they are listed
// in.
//
// `uart_tx` is B9 and it is the FPGA's OUTPUT -- A9 is the FPGA's receive line
// and driving it would fight the debugger. The iCELink presents this pair as a
// USB CDC serial port, which is the only way anything on this board reports a
// number.
//
// Unlike soc/littlesoc.lpf, this file is for a BITSTREAM and not a
// measurement, so it constrains every port the top level has. That file leaves
// three of four unconstrained on purpose because the Colorlight i5 is a module
// whose baseboard varies; here the board is the whole thing.
LOCATE COMP "clk_pin" SITE "P6";
IOBUF PORT "clk_pin" IO_TYPE=LVCMOS33;

LOCATE COMP "led_g_n" SITE "A11";
IOBUF PORT "led_g_n" IO_TYPE=LVCMOS33;

LOCATE COMP "led_r_n" SITE "B11";
IOBUF PORT "led_r_n" IO_TYPE=LVCMOS33;

LOCATE COMP "uart_tx" SITE "B9";
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;
