--- /dev/null
+++ b/rtl/fetchqueue.v
@@ -0,0 +1,50 @@
+`timescale 1 ns / 1 ps
+`default_nettype none
+// Spike only, decoupled-fetch variant: a flat FIFO of individual fetched WORDS, not of
+// fixed windows. The shipping fetch logic re-requests "the word at pc, and the one after
+// it" fresh every cycle at whatever 2-byte alignment pc has; a window tied to an 8-byte
+// tile cannot supply that once pc walks into its second half. Words are pushed in pairs
+// (one fetch answers two neighbouring words) and popped one at a time, as decode's own
+// pc crosses each word boundary -- q0/q1 are always "the word at pc" and "the next one".
+module fetchqueue (
+  input  logic clk,
+  input  logic reset,
+  input  logic flush,
+  input  logic push_valid,
+  input  logic [31:0] push_lo,
+  input  logic [31:0] push_hi,
+  input  logic pop,
+  output logic [31:0] q0,
+  output logic [31:0] q1,
+  output logic q_valid,
+  output logic [3:0] count
+);
+  localparam int DEPTH = 8;
+  logic [31:0] mem [0:DEPTH-1];
+  logic [2:0]  head, tail;
+  logic [3:0]  cnt;
+
+  logic do_pop;
+  assign do_pop = pop && (cnt != 4'd0);
+
+  always_ff @(posedge clk) begin
+    if (reset || flush) begin
+      head <= 3'd0;
+      tail <= 3'd0;
+      cnt  <= 4'd0;
+    end else begin
+      if (do_pop) head <= head + 3'd1;
+      if (push_valid) begin
+        mem[tail]      <= push_lo;
+        mem[tail+3'd1] <= push_hi;
+        tail <= tail + 3'd2;
+      end
+      cnt <= cnt - (do_pop ? 4'd1 : 4'd0) + (push_valid ? 4'd2 : 4'd0);
+    end
+  end
+
+  assign q0 = mem[head];
+  assign q1 = mem[head + 3'd1];
+  assign q_valid = cnt >= 4'd2;
+  assign count = cnt;
+endmodule
