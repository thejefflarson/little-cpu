// The Sail RISC-V model, configured as THIS core: RV32IMC_Zicsr, machine mode
// only. Passed as `sail_riscv_sim --config`, NOT `--rv32
// --config-override`, and that distinction is the point of the file.
//
// WHY A WHOLE CONFIG AND NOT AN OVERRIDE
// --------------------------------------
// An override inherits everything it does not mention. The previous file was a
// small override on the model's default RV32 machine, so the reference model
// this repo cross-checks against had atomics, bit-manipulation, single and
// double float, supervisor mode, user mode and vectors -- none of which this
// core implements, and none of which anybody chose. It surfaced as one wrong
// CSR read (`csrr misa` reported 0x4034112f against this core's 0x40001104),
// but `misa` was the symptom: a model that believes S-mode exists has
// different trap delegation, different address translation and different CSR
// legality, and M3's trap work is exactly what starts to touch those.
//
// `--config` takes a COMPLETE configuration. The model's schema check rejects
// a file with a missing key -- verified, it names every one -- so nothing is
// inherited silently and a version bump that adds a knob fails loudly here
// instead of quietly picking a default. That is the property worth the length.
//
// Regenerate the skeleton with `sail_riscv_sim --rv32 --print-default-config`
// and re-apply the decisions below; `--print-config-schema` documents the
// value space. `--validate-config` checks one without running a program.
//
// A CONFIG OVERRIDE IS WHERE YOU CAN TALK THE ORACLE INTO AGREEING WITH YOU.
// Sail is authoritative about RISC-V semantics but NOT about which
// implementation-defined choice this core makes -- we tell it that. So every
// knob below traces to the ISA target, the trap and CSR set, or the memory
// map -- decisions that predate the divergence each one resolves. Nothing here
// was chosen because it made a test pass.
//
// WHAT THIS FILE CANNOT SAY. Three implementation-defined values remain
// different because sail-riscv 0.13.1 has no knob for them, and they are NOT
// all handled the same way -- the difference matters:
//
//   * `mcycle`/`mcycleh` (an ISA model has no pipeline) are exempted by name
//     in test/cosim.py's NONCOMPARABLE_CSRS, keyed on the CSR encoding and
//     scoped to one register at one comparison point.
//
//   * `mie` (the model hardwires MSIE/MTIE/MEIE writable; this core makes them
//     read-only zero) and `mip` (the model's mtime keeps ticking with the
//     CLINT unmapped and raises MTIP; this core has no timer) are NOT in
//     NONCOMPARABLE_CSRS and cannot be -- a value exemption cannot help here,
//     because a program asserting they read zero takes a DIFFERENT BRANCH on
//     the two machines rather than reading a different value. Those assertions
//     live in test/csr_tb.v instead, against rtl/csrs.v, where there is no
//     reference model to disagree. test/cosim.py's own comment above
//     NONCOMPARABLE_CSRS says this correctly; this header used to claim all
//     three were exempted there, and that was wrong.
//
// See docs/adr/0043.
{
  "base": {
    "xlen": 32,
    // RV32I, not RV32E: x16-x31 exist.
    "E": false,

    // rtl/csrs.v returns misa as a constant 0x4000_1104. A `csrw misa` on this
    // core is a write to a read-only-value CSR, not a way to turn C off.
    "writable_misa": false,

    // menvcfg.FIOM only exists with U-mode, which this core does not have.
    "writable_fiom": false,

    // Not one bit: rtl/csrs.v answers all 87 mhpmcounter/mhpmevent addresses
    // with a constant zero and swallows the write, which is what the
    // privileged spec permits and what `Zihpm` plus an empty mask spells here.
    "writable_hpm_counters": { "len": 32, "value": "0x0000_0000" },

    // scounteren/mcounteren gate counter access from LOWER privilege levels.
    // There are none (M-mode only), so no bit of either is writable.
    "scounteren_writable_bits": { "len": 32, "value": "0x0000_0000" },
    "mcounteren_writable_bits": { "len": 32, "value": "0x0000_0000" },

    // Direct mode only, 4-byte-aligned base: rtl/csrs.v's WARL mask on mtvec
    // is `{wdata[31:2], 2'b00}`, which forces MODE=0 and clears the low two
    // bits of BASE. `base_alignment` is the exponent, so 2 == 4 bytes.
    "mtvec": {
      "direct":   { "supported": true,  "base_alignment": 2 },
      "vectored": { "supported": false, "base_alignment": 2 }
    },

    // S is disabled, so stvec does not exist and these keys are never
    // consulted. The schema requires them; left at the model's defaults
    // rather than invented, so that a future S-mode target starts from
    // upstream's values rather than from something this file made up.
    "stvec": {
      "direct":   { "supported": true },
      "vectored": { "supported": true, "base_alignment": 2 }
    },

    // Nothing to delegate to: no S-mode, no U-mode. Both mask to
    // zero, which makes medeleg/mideleg read-only zero in the model.
    "medeleg": { "delegatable_bits": { "len": 64,    "value": "0x0000_0000_0000_0000" } },
    "mideleg": { "delegatable_bits": { "len": "xlen", "value": "0x0000_0000" } },

    // rtl/csrs.v hardwires mtval to 0, which is spec-legal for every cause
    // this core raises. Every trap therefore writes mtval = 0.
    "xtval_nonzero": {
      "illegal_instruction": false,
      "software_breakpoint": false,
      "hardware_breakpoint": false,
      "load_address_misaligned": false,
      "load_access_fault": false,
      "load_page_fault": false,
      "samo_address_misaligned": false,
      "samo_access_fault": false,
      "samo_page_fault": false,
      "fetch_address_misaligned": false,
      "fetch_access_fault": false,
      "fetch_page_fault": false,
      "software_check": false,
      "reserved_exceptions": false
    },

    // Reserved-encoding behaviour. Every one of these but `xtvec_mode` belongs
    // to an extension disabled below and is unreachable; they are required
    // keys, so they keep upstream's non-fatal choice -- a model that halts on
    // an encoding this core merely treats as illegal would report a broken
    // harness as a divergence. `xtvec_mode` IS reachable: with vectored mode
    // unsupported, a `csrw mtvec` carrying MODE=1 is ignored by the model,
    // and rtl/csrs.v's WARL mask forces MODE=0 -- same architectural result
    // from a mtvec whose MODE was already 0, which is the only state this
    // core can be in.
    "reserved_behavior": {
      "amocas_odd_register": "AMOCAS_Illegal",
      "fcsr_rm": "Fcsr_RM_Illegal",
      "pmpcfg_write_only": "PMP_ClearPermissions",
      "xenvcfg_cbie": "Xenvcfg_ClearPermissions",
      "xtvec_mode": "Xtvec_Ignore",
      "rv32zdinx_odd_register": "Zdinx_Illegal"
    },

    // No F/D and no V, so mstatus.FS and mstatus.VS are read-only zero.
    // rtl/csrs.v builds mstatus out of MIE/MPIE and a hardwired MPP; every
    // other field reads zero, which is what ExtContext_Off means here. The
    // model's own validator demands these two once F, D, V and S are off.
    "mstatus": {
      "fs_legal_states": "ExtContext_Off",
      "vs_legal_states": "ExtContext_Off"
    },

    "privileged_isa_version": "Privileged_ISA_1_13"
  },

  "memory": {
    // 32-bit physical addresses. The model's default is 34, which it only
    // permits with Sv32 enabled.
    "physaddr_bits": 32,

    // No PMP. `count: 0` makes every pmpcfg/pmpaddr read-only zero;
    // the remaining keys describe a granularity that no entry can use.
    "pmp": {
      "grain": 0,
      "count": 0,
      "usable_count": 0,
      "tor_supported": true,
      "na4_supported": true,
      "napot_supported": true
    },

    // MISALIGNED ACCESSES MUST TRAP, and this is the key that decides it --
    // NOT the per-region `misaligned_exceptions` attribute below, which is
    // restated in the region and has NO EFFECT here. The model's own default
    // config documents the difference: this global key is "checked before
    // address translation" while the region attribute is "checked after", and
    // with no MMU the region attribute is never consulted. Measured, not
    // inferred: changing the region attribute leaves a misaligned `lw`
    // completing; setting this one redirects to mtvec.
    //
    // `AlignmentException` is the value matching this core's causes: load
    // address misaligned = 4, store address misaligned = 6. `AccessFault`
    // would be causes 5 and 7 and is a different implementation choice this
    // core did not make -- it raises neither cause anywhere.
    //
    // `amo` and `lrsc` say the same thing for the same reason, now that the
    // model executes those instructions. Both were upstream defaults chosen for
    // a machine with A disabled, and `amo`'s default let a misaligned AMO
    // complete without faulting at all. Neither is reachable from test/asm
    // today; they are written down because the alternative is discovering the
    // model's default the first time the suite grows a misaligned AMO. The
    // `vector` entry still belongs to V, which is disabled.
    "misaligned": {
      "exceptions": {
        "load_store": { "Some": "AlignmentException" },
        "vector": { "None": null },
        "amo": { "Some": "AlignmentException" },
        "lrsc": "AlignmentException"
      },
      "order_decreasing": false,
      "default_allowed_within_exp": 0,
      "byte_by_byte": false
    },

    // Only consulted when a device tree is generated or loaded, which this
    // harness never does (no --device-tree-blob, no --print-device-tree).
    "dtb_address": { "len": 64, "value": "0x1000" },

    // TWO regions, split where this core's fetch decode splits: test/asm's `rom`
    // is 16 KB at 0x0 and rtl/imemory.v answers nothing above it, so a PC past
    // 16 KB is an instruction access fault here and on the core alike. The
    // second region carries the rest of the 1 MB the linker script may grow
    // into -- `ram` at 0x10000, the timer's four words at 0x20000, and the gap
    // around them -- readable and writable but NOT executable, which is the
    // whole content of the split. test/asm/ifault.S jumps into it on purpose.
    //
    // Everything else about the second region matches the first, because the
    // core does not distinguish them for loads and stores: an out-of-region
    // data access is answered rather than refused, so a Sail region that
    // refused one would diverge from the core on a program that made one. That
    // is the half of the map this core does not yet enforce.
    //
    // The model's default RV32 map puts MainMemory at
    // 0x8000_0000, where nothing this suite builds is executable or loadable.
    //
    // The default map's other two regions are deliberately absent. Its
    // unwritable IOMemory window at 0x0000_1000 overlaps `.text` and the model
    // rejects overlapping regions; nothing needs it, because the PC comes from
    // the ELF entry point rather than from a reset vector there. Its CLINT
    // window at 0x0200_0000 went with `platform.clint.supported: false` below.
    //
    // The model detects HTIF from the ELF's `tohost` symbol, reports "HTIF
    // located at 0x10000", and TERMINATES on this suite's verdict write --
    // `SUCCESS`, or `FAILURE: <testnum>`. `--inst-limit` is
    // therefore a runaway bound, not a convergence criterion.
    "regions": [
      {
        "base": { "len": 64, "value": "0x0000_0000" },
        "size": { "len": 64, "value": "0x0000_4000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": true,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          "atomic_support": "AMOCASQ",
          "misaligned_atomicity_granule_size_exp": 4,
          "vector_misaligned_atomicity_granule_size_exp": 4,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": true,
          "supports_pte_read": true,
          "supports_pte_write": true
        },
        "include_in_device_tree": true
      },
      {
        "base": { "len": 64, "value": "0x0000_4000" },
        "size": { "len": 64, "value": "0x000f_c000" },
        "attributes": {
          "mem_type": "MainMemory",
          "cacheable": true,
          "coherent": true,
          "executable": false,
          "readable": true,
          "writable": true,
          "read_idempotent": true,
          "write_idempotent": true,
          "misaligned_exceptions": {
            "load_store": { "None": null },
            "vector": { "None": null },
            "amo": "AccessFault"
          },
          "atomic_support": "AMOCASQ",
          "misaligned_atomicity_granule_size_exp": 4,
          "vector_misaligned_atomicity_granule_size_exp": 4,
          "reservability": "RsrvEventual",
          "supports_cbo_zero": true,
          "supports_pte_read": true,
          "supports_pte_write": true
        },
        "include_in_device_tree": true
      }
    ]
  },

  "platform": {
    // rtl/csrs.v returns all four as read-only zero.
    "vendorid": 0,
    "archid": 0,
    "impid": 0,
    "hartid": 0,

    // Zicbom/Zicbop/Zicboz are disabled; no instruction consults this.
    "cache_block_size_exp": 6,

    // THE RESERVATION POLICY, which is the one part of LR/SC the spec leaves to
    // the implementation and therefore the one part a reference model cannot be
    // authoritative about. An SC's result is an architectural register value, so
    // a model that drops a reservation where this core keeps it makes every
    // LR/SC program a co-simulation divergence on a correct core.
    //
    // `reservation_set_size_exp` is the size AND alignment of the set, as an
    // exponent; 2 is the RV32 minimum and is one 4-byte word, which is what this
    // core reserves -- it compares word addresses.
    //
    // `require_exact_reservation_addr` forces an exact address match REGARDLESS
    // of that size. The two therefore overlap, and measuring both is the only
    // way to see it -- an sc.w one word up from the reservation, which this core
    // fails:
    //
    //   size_exp  exact    that sc.w
    //   2         true     fails
    //   2         false    fails
    //   3         true     fails
    //   3         false    SUCCEEDS
    //
    // So the pair below is two independent reasons for the same answer, not one
    // reason and one redundant knob: at a one-word set the exact-match knob is
    // unobservable, and with exact matching on the set size is. Both are set to
    // what this core does rather than to whichever one happened to be load-
    // bearing, because the other is what a later widening would land on.
    //
    // `invalidate_on_same_hart_store` is `true` because this core clears the
    // reservation on a store from this hart whose word address matches -- one
    // hart is all there is, so a model that ignored same-hart stores would
    // succeed at an SC this core fails. It is the one knob here that is
    // load-bearing on its own: at `false` the probe's same-hart-store case
    // succeeds. Spurious SC failure is architecturally permitted and the reverse
    // is what needs an argument, so this is the direction that has to agree.
    //
    // What the model does at a trap and at an mret is NOT a knob. It is
    // observed by test/sail/reservation_probe.sh and recorded in docs/adr/0102.
    "reservation": {
      "reservation_set_size_exp": 2,
      "require_exact_reservation_addr": true,
      "invalidate_on_same_hart_store": true
    },

    // No CLINT and no interrupt generator: this core has neither, and no
    // interrupt sources at all. Turning the CLINT off is what
    // lets the 0x0200_0000 IOMemory region go away.
    //
    // MEASURED CAVEAT, and the reason mip is in cosim.py's NONCOMPARABLE_CSRS:
    // `supported: false` unmaps the CLINT's MMIO window but does NOT stop the
    // model's mtime from advancing. mtimecmp resets to zero, so mtime passes
    // it on the first tick and the model sets mip.MTIP -- `CSR mip (0x344) <-
    // 0x00000080` on the second instruction of every program, under
    // --trace-reg. There is no knob for it: `platform.clint` has exactly
    // `base`, `size` and `supported`, and nothing in the schema names mtimecmp
    // or MTIP.
    "clint": { "supported": false, "base": 33554432, "size": 786432 },
    "simple_interrupt_generator": { "supported": false, "base": 201326592 },

    // Device-tree decoration only.
    "clock_frequency": 1000000000,

    // This drives mtime AND mcycle. It is left at the model's default rather
    // than stretched to keep mtime at zero: test/asm/minstret.S asserts that
    // mcycle advances between two reads, and a tick period longer than the
    // run would make that assertion fail on the reference side -- turning a
    // real property into a false divergence. mcycle's RATE is not comparable
    // between a pipeline and an ISA model at any setting, which is the actual
    // problem and is handled where it belongs (docs/adr/0043).
    "instructions_per_tick": 2,

    // rtl/decoder.v decodes `wfi` and executes it as a NOP, which is
    // spec-legal with mie/mip read-only zero: there is no interrupt to wait
    // for. `wfi` from U-mode cannot arise -- there is no U-mode.
    "wfi_is_nop": true,
    "wfi_available_to_user_mode": false,
    "max_time_to_wait": 10
  },

  // EXTENSIONS -- audited against the ISA target. Enabled: I (the base), M, C
  // and Zicsr, plus the ones that are enabled for a stated reason rather than
  // because the target names them:
  //
  //   Zca    is the C extension for this target. misa.C is set from Zca alone
  //          once F and D are off (Zcf and Zcd would otherwise be required
  //          too), which is what brings misa to 0x4000_1104.
  //   Zicntr is enabled because it is what makes mcycle/minstret EXIST in the
  //          model -- measured: with it off, `csrr a0, minstret` raises an
  //          illegal-instruction trap and test/asm/trap.S and
  //          test/asm/minstret.S both fail on the reference side. This core
  //          implements the machine counters (rtl/csrs.v: mcycle, mcycleh,
  //          minstret, minstreth) and riscv-formal's `[csrs] mcycle minstret`
  //          requires them. RESIDUAL, recorded rather than fixed: Zicntr also
  //          gives the model the unprivileged shadows `cycle`/`time`/`instret`
  //          (0xC00-0xC02), which this core does not implement and would trap
  //          on. No program in test/asm reads them; there is no knob to
  //          separate the machine counters from the shadows.
  //   Zihpm  is enabled for the same kind of reason and needs the same care.
  //          The privileged spec puts mhpmcounter3-31 and mhpmevent3-31 in
  //          M-mode's own performance-monitor facility, asks for all of them
  //          and permits every one to read zero; rtl/csrs.v takes that offer,
  //          so those 87 addresses read zero here rather than trapping. The
  //          model gates them on Zihpm instead, so `supported: false` is a
  //          machine that traps on all 87 and `true` with
  //          `writable_hpm_counters` empty is a machine that reads them as
  //          zero -- measured both ways on test/asm/hpm.S, DISAGREE AT 2 and
  //          AGREE. RESIDUAL, the same shape as Zicntr's: it also gives the
  //          model the unprivileged shadows `hpmcounter3-31` (0xC03-0xC1F),
  //          which this core traps on, and no knob separates them. Enabling it
  //          is NOT a claim that the ISA string grows -- Zihpm has no misa bit
  //          and names the unprivileged shadows, not the machine counters.
  //   Zifencei is enabled because rtl/decoder.v decodes `fence.i` and retires
  //          it as a NOP (one hart, Harvard, nothing to invalidate).
  //          With it off the model would raise an illegal instruction where
  //          this core does not.
  //
  // EVERYTHING ELSE IS FALSE. Not "left alone" -- false. Most are unreachable
  // by this suite today, and that is exactly why they have to be written down:
  // an extension the model believes in is an encoding it will execute where
  // this core raises cause 2, and the suite growing one instruction is all it
  // takes to find out.
  "extensions": {
    // --- the target -------------------------------------------------------
    "M": { "supported": true },
    "Zicsr": { "supported": true },
    "Zca": { "supported": true },
    "Zicntr": { "supported": true },
    "Zihpm": { "supported": true },
    "Zifencei": { "supported": true },

    // --- the misa bits that were wrong ------------------------------------
    // A, B, D, F, S, U and V. Each was `true` in the model's default RV32
    // machine and none of them is implemented here. A is the one that has since
    // split in two -- the key below is only its misa bit; see the Za* block.
    "A": { "supported": false },
    "B": { "supported": false },
    "D": { "supported": false },
    "F": { "supported": false, "fflags_dirty_policy": "Fflags_Dirty_Precise" },
    "S": { "supported": false },
    "U": { "supported": false },
    "V": {
      "support_level": "Disabled",
      "vlen_exp": 8,
      "elen_exp": 6,
      "reserved_behavior": {
        "illegal_vtype": "IllegalVtype_SetVill",
        "vstart_out_of_bounds": "Vstart_Illegal"
      },
      "vl_use_ceil": false,
      "max_index_eew_exp": 6,
      "vstart": { "zero_required": { "arith": true, "scalar_move": true } }
    },

    // --- Zi*: unprivileged extras -----------------------------------------
    // Every one of these adds instructions or CSRs rtl/decoder.v treats as
    // illegal. Zimop/Zcmop reserve encodings as no-ops, Zicond adds
    // czero.eqz/nez, Zicbo* add cache-management ops, Zicfilp/Zicfiss add
    // landing pads and a shadow stack, Zihintntl/Zihintpause are hints this
    // core does not decode. The Zic*/Ziccamo* entries are profile
    // compatibility declarations about the memory system; they claim
    // guarantees this core does not make. Zihpm used to be in this list and is
    // now enabled with the target, for the reason the header gives.
    "Zibi": { "supported": false },
    "Zic64b": { "supported": false },
    "Zicbom": { "supported": false },
    "Zicbop": { "supported": false },
    "Zicboz": { "supported": false },
    "Ziccamoa": { "supported": false },
    "Ziccamoc": { "supported": false },
    "Ziccif": { "supported": false },
    "Zicclsm": { "supported": false },
    "Ziccrse": { "supported": false },
    "Zicfilp": { "supported": false },
    "Zicfiss": { "supported": false },
    "Zicond": { "supported": false },
    "Zihintntl": { "supported": false },
    "Zihintpause": { "supported": false },
    "Zimop": { "supported": false },

    // --- M subsets and A subsets ------------------------------------------
    // Zmmul is the multiply-only subset of M; M itself is on, so this stays
    // off (it is off in the model's default too).
    "Zmmul": { "supported": false },

    // ZAAMO IS THE NINE AMOs AND ZALRSC IS lr.w/sc.w. Both are on: the model
    // has to EXECUTE them for the A extension's semantics to be co-simulable at
    // all, and test/sail/reservation_probe.sh is what asks it questions about
    // them.
    //
    // `A` ABOVE IS NOT AN UMBRELLA OVER THESE TWO. It is the misa.A bit and
    // nothing else, and that is the whole reason it is still false while these
    // are true. Measured, all four combinations, with a csrr of misa and with
    // the probe:
    //
    //   A     Zaamo/Zalrsc   misa         lr.w/sc.w
    //   true  true           0x40001105   execute
    //   true  false          0x40001105   execute
    //   false true           0x40001104   execute
    //   false false          0x40001104   illegal instruction
    //
    // rtl/csrs.v returns misa as a constant 0x40001104, so `A: true` would put
    // 0x40001105 in an architectural register at test/asm/csr.S's two misa
    // reads and diverge there -- a red co-simulation gate earned by the
    // reference model, not by the core. `A` FLIPS IN THE SAME CHANGE THAT MAKES
    // rtl/csrs.v CLAIM THE BIT, and not before. Turning it on early would also
    // hide that transition: with the model already claiming A, the change that
    // makes the core claim it would go green either way.
    //
    // The rest of the Za* family stays off because it is not this target: Zabha
    // is byte and halfword AMOs, Zacas is compare-and-swap, Zama16b is a
    // misaligned atomicity guarantee this core does not make, and Zawrs is a
    // wait-on-reservation pair that would need a reservation the fetch path
    // could see.
    "Zaamo": { "supported": true },
    "Zalrsc": { "supported": true },
    "Zabha": { "supported": false },
    "Zacas": { "supported": false },
    "Zama16b": { "supported": false },
    "Zawrs": {
      "supported": false,
      "nto": { "is_nop": false },
      "sto": { "is_nop": false }
    },

    // --- floating point, in every packaging -------------------------------
    // F and D above, their extras here, and the *inx variants that put floats
    // in the integer registers. None of it exists on this core.
    "Zfa": { "supported": false },
    "Zfbfmin": { "supported": false },
    "Zfh": { "supported": false },
    "Zfhmin": { "supported": false },
    "Zfinx": { "supported": false },
    "Zdinx": { "supported": false },
    "Zhinx": { "supported": false },
    "Zhinxmin": { "supported": false },

    // --- compressed, beyond Zca -------------------------------------------
    // Zcf and Zcd are the compressed float loads/stores; they need F and D.
    // Zcb adds compressed byte/halfword ops and is NOT part of C. Zcmop
    // reserves compressed may-be-ops. rtl/decoder.v decodes none of them.
    "Zcf": { "supported": false },
    "Zcd": { "supported": false },
    "Zcb": { "supported": false },
    "Zcmop": { "supported": false },

    // --- bit manipulation and crypto --------------------------------------
    // B above is the umbrella; these are its members and the scalar crypto
    // family built on them.
    "Zba": { "supported": false },
    "Zbb": { "supported": false },
    "Zbs": { "supported": false },
    "Zbc": { "supported": false },
    "Zbkb": { "supported": false },
    "Zbkc": { "supported": false },
    "Zbkx": { "supported": false },
    "Zknd": { "supported": false },
    "Zkne": { "supported": false },
    "Zknh": { "supported": false },
    "Zkr": {
      "supported": false,
      "sseed_reset_value": false,
      "useed_reset_value": false,
      "sseed_read_only_zero": false,
      "useed_read_only_zero": false
    },
    "Zksed": { "supported": false },
    "Zksh": { "supported": false },
    "Zkt": { "supported": false },

    // --- vector extras ----------------------------------------------------
    // V is Disabled above; these are the extensions layered on it.
    "Zvabd": { "supported": false },
    "Zvfbfmin": { "supported": false },
    "Zvfbfwma": { "supported": false },
    "Zvfh": { "supported": false },
    "Zvfhmin": { "supported": false },
    "Zvbb": { "supported": false },
    "Zvbc": { "supported": false },
    "Zvkb": { "supported": false },
    "Zvkg": { "supported": false },
    "Zvkned": { "supported": false },
    "Zvknha": { "supported": false },
    "Zvknhb": { "supported": false },
    "Zvksed": { "supported": false },
    "Zvksh": { "supported": false },
    "Zvkt": { "supported": false },

    // --- supervisor, machine and paging -----------------------------------
    // S and U are off above, so none of this is reachable; it is written down
    // because M3's trap work is where a model that quietly believes in S-mode
    // would start producing wrong answers about delegation and about which
    // CSRs are legal. Sv32/Sv39/Sv48/Sv57 and Svbare are address translation;
    // Ssccptr/Svade/Svadu/Svvptc/Svnapot/Svpbmt/Svinval/Svrsw60t59b are page
    // table behaviours; Ss*/Sm* are supervisor and machine counter, pointer
    // masking, state enable and QoS extensions.
    "Ssccptr": { "supported": false },
    "Sscofpmf": { "supported": false },
    "Sscounterenw": { "supported": false },
    "Sstc": { "supported": false },
    "Sstvala": { "supported": false },
    "Svade": { "supported": false },
    "Svadu": { "supported": false },
    "Svinval": { "supported": false },
    "Svrsw60t59b": { "supported": false },
    "Svnapot": { "supported": false },
    "Ssnpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smnpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smmpm": {
      "supported": false,
      "supported_pmlen_7": true,
      "supported_pmlen_16": true
    },
    "Smcntrpmf": { "supported": false },
    "Svbare": { "supported": false, "sfence_vma_illegal_if_svbare_only": true },
    "Sv32": { "supported": false },
    "Sv39": { "supported": false },
    "Sv48": { "supported": false },
    "Sv57": { "supported": false },
    "Stateen": {
      "Smstateen": { "supported": false },
      "Ssstateen": { "supported": false },
      "C_readonly_zero": true,
      "SE0_readonly_zero": false
    },
    "Ssqosid": { "supported": false, "rcid_length": 12, "mcid_length": 12 },
    "Svpbmt": { "supported": false },
    "Svvptc": { "supported": false }
  }
}
