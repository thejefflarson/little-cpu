[options]
isa rv32imc
solver btormc

[csrs]
mcycle   inc upcnt
minstret inc upcnt

[depth]
#derive F 12  worst-case first retire, swept out of `hang`
#derive G 10  worst-case gap between two retires, swept out of `liveness`
#floor insn   F+2G          one retire, assume(valid) at the check cycle, every assertion about it
#floor csrw   F+2G          insn's shape, over a CSR instruction rather than an ISA-table one
#floor reg    F+G,start+G   two retires: the write is shadowed from the start cycle and read back at the check cycle
#floor pc_fwd F+G,start+G   two retires, the predecessor's pc_wdata shadowed from the start cycle
#floor pc_bwd F+G,start+G   pc_fwd's shape, in the other direction
#floor causal F+G,start+G   two retires: the later reader is found in the window and the writer asserts at the check cycle
#floor liveness F+G,trig+G  the retire assumed at trig and its successor, which has to fall inside the window
#floor unique   F+G,trig+G  liveness's shape: two retires, one window
#floor hang     F+1         the first retire alone, asserted on a registered flag
insn           33
reg      13    24
pc_fwd   13    24
pc_bwd   13    24
liveness 1  13 24
unique   1  13 24
causal   13    24
hang     1     14
csrw           33

[script-sources]
read_verilog -sv @@NANO_FORMAL_DIR@@/wrapper.v
read_verilog -sv @@NANO_FORMAL_DIR@@/../nano.v

[defines]
`define RISCV_FORMAL_ALIGNED_MEM
`define RISCV_FORMAL_ALTOPS

[defines liveness]
`define RISCV_FAIRNESS

[defines hang]
`define RISCV_FAIRNESS
