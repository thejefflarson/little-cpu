# The shared-bus tie-off declared in every riscv-formal harness; format and rationale in docs/manifests/multihart-tie-off.md.

HARNESS  wrapper.v
HARNESS  complete.sv
HARNESS  cover.sv
HARNESS  dmemcheck.sv
HARNESS  imemcheck.sv

PORT bus_wait    1'b0
PORT snoop_write 1'b0
PORT snoop_addr  32'b0

ELSEWHERE irq_timer INTERRUPT_TIE_OFF
