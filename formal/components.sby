[tasks]
executor all
decoder all
accessor all
pcloop all
traps all
busarbiter all

[options]
all: mode prove

[engines]
all: smtbmc
# The generated checks' solver finding (formal/checks.cfg's `solver` line),
# reproduced on a different query. `smtbmc` with no solver name is
# yosys-smtbmc's default, yices, and it is fine for the two standalone tasks.
# On `pcloop` it is not: measured on this tree, yices sat in the basecase at
# step 6 for over FOURTEEN MINUTES without returning, while `smtbmc boolector`
# cleared basecase and induction and reported `successful proof by k-induction`
# in about five seconds. Same task, same depth, same RTL -- only the solver
# differs, which is exactly the shape reg_ch0 showed under `smtbmc yices`.
#
# Deliberately NOT the `btor` engine, which is what the generated checks use:
# btormc does bmc and cover only, and this task is `mode prove`.
#
# boolector ships in the OSS CAD Suite, which anything under formal/
# needs anyway. It is NOT in a bare `brew install yosys`; if that ever has to
# hold, `smtbmc z3` is the next thing to measure rather than reverting to the
# default and calling a fourteen-minute non-answer a slow proof.
pcloop: smtbmc boolector

# `--keep-going` reports EVERY assertion a failing step breaks instead of
# stopping at the first, and this task has assertions that catch one defect
# several steps before another does: a starving arbiter breaks the round-robin
# handoff at step 3 and the wait bound at step 6, and the first alone does not
# say the bound still works. Free on a run that passes -- there is nothing to
# keep going past -- so busarbiter-probe.py grades the engine that ships rather
# than a second one of its own.
busarbiter: smtbmc --keep-going

[script]
decoder:
read -sv -formal structs.v decoder.v regsel.v
prep -top decoder

executor:
read -formal structs.v executor.v
prep -top executor

accessor:
read -sv -formal structs.v accessor.v
prep -top accessor

pcloop:
# The RTL is deliberately read WITHOUT -formal: -formal defines FORMAL, and
# rtl/decoder.v's own `ifdef FORMAL` block contains `assume(in.pc == pc)` --
# the standalone-task model of the fetcher that this composed task
# exists to discharge. Compiled into the instance, that assume makes the echo
# assertion circular (it is assumed inside the very design it is asserted of)
# and turns a broken fetcher into an unreachable state instead of a
# counterexample: mutating fetcher.v's `out.pc = pc` to `out.pc = 0` still
# "passed" until this split, because the only traces satisfying the imported
# assume were perpetual-stall ones. Each component's FORMAL block belongs to
# its own task; only the harness carries proof content here.
read -sv structs.v fetcher.v decoder.v regsel.v
read -sv -formal structs.v pcloop.sv
prep -top pcloop

traps:
# The same split as pcloop and for the same reason, drawn one statement finer.
# `-noassume` drops rtl/decoder.v's assume(in.pc == pc) -- the standalone model
# of the fetcher that the instance below is what answers here -- while keeping
# its assertions, and it is the assume alone that made pcloop's echo circular.
# The three reset assumes it also drops are restated in traps.sv verbatim.
#
# THE ASSERTIONS HAVE TO COME IN, and induction is what needs them. The
# decoder answers the load/store region question a cycle late, which is state
# no port publishes: induction may start from a held answer that belongs to no
# access, and `must_not_trap => !trap_entry` then fails on a trace no run
# reaches. The invariant that rules that state out is a statement about the
# decoder's own registers, so it is asserted where they are visible. Nothing in
# this harness can reach them -- yosys resolves no hierarchical reference and
# ignores `bind`, and both failure modes are silent: `decoder.ls_answer_valid`
# parses as an implicitly declared undriven wire whose value the solver picks.
read -sv -formal -noassume structs.v fetcher.v decoder.v regsel.v csrs.v
read -sv -formal structs.v traps.sv
prep -top traps

busarbiter:
# The RTL is read WITH -formal, unlike pcloop and traps: rtl/busarbiter.v
# carries no `ifdef FORMAL` block, so there is no assume of its own to compile
# into the instance and nothing for the harness to be circular about. Give it
# one and this line has to split the way those two did.
read -sv -formal busarbiter.v busarbiter.sv
prep -top busarbiter_check
--
[files]
decoder:
../rtl/decoder.v
../rtl/regsel.v
../rtl/structs.v

executor:
../rtl/executor.v
../rtl/structs.v

accessor:
../rtl/accessor.v
../rtl/structs.v

pcloop:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/regsel.v
../rtl/structs.v
pcloop.sv

traps:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

busarbiter:
../rtl/busarbiter.v
busarbiter.sv

--
