[tasks]
executor all
decoder all
accessor all
pcloop all
traps all
traps_pc all
traps_cause all
traps_status all
traps_quiescence all
busarbiter all

[options]
all: mode prove

[engines]
# No `all:` line: sby ADDS it to a task's own engine instead of replacing it.
decoder: smtbmc
accessor: smtbmc
traps: smtbmc bitwuzla
# Each traps_* task proves a disjoint subset of traps.sv's own assertions (see
# TRAPS_CHECK_* in traps.sv and formal/TRAPS_GROUPS); same engine as traps itself,
# since each is the same composed environment with fewer goals, not a smaller one.
traps_pc: smtbmc bitwuzla
traps_cause: smtbmc bitwuzla
traps_status: smtbmc bitwuzla
traps_quiescence: smtbmc bitwuzla
pcloop: smtbmc boolector
# executor is most of this job's clock; bitwuzla proves it in 101s against 245s.
executor: smtbmc bitwuzla

busarbiter: smtbmc --keep-going

[script]
decoder:
read -sv -formal structs.v decoder.v regsel.v
prep -top decoder

executor:
read -formal structs.v executor.v
prep -top executor

accessor:
read -sv -formal structs.v accessor.v
prep -top accessor

pcloop:
read -sv -formal -noassume structs.v fetcher.v
read -sv structs.v decoder.v executor.v regsel.v
read -sv -formal structs.v pcloop.sv
prep -top pcloop

traps:
# The same split as pcloop and for the same reason, drawn one statement finer.
read -sv -formal -noassume structs.v fetcher.v decoder.v executor.v regsel.v csrs.v
read -sv -formal structs.v traps.sv
prep -top traps

traps_pc:
read -sv -formal -noassume structs.v fetcher.v decoder.v executor.v regsel.v csrs.v
read -sv -D TRAPS_SPLIT -D TRAPS_CHECK_PC -formal structs.v traps.sv
prep -top traps

traps_cause:
read -sv -formal -noassume structs.v fetcher.v decoder.v executor.v regsel.v csrs.v
read -sv -D TRAPS_SPLIT -D TRAPS_CHECK_CAUSE -formal structs.v traps.sv
prep -top traps

traps_status:
read -sv -formal -noassume structs.v fetcher.v decoder.v executor.v regsel.v csrs.v
read -sv -D TRAPS_SPLIT -D TRAPS_CHECK_STATUS -formal structs.v traps.sv
prep -top traps

traps_quiescence:
read -sv -formal -noassume structs.v fetcher.v decoder.v executor.v regsel.v csrs.v
read -sv -D TRAPS_SPLIT -D TRAPS_CHECK_QUIESCENCE -formal structs.v traps.sv
prep -top traps

busarbiter:
read -sv -formal busarbiter.v busarbiter.sv
prep -top busarbiter_check
--
[files]
decoder:
../rtl/decoder.v
../rtl/regsel.v
../rtl/structs.v

executor:
../rtl/executor.v
../rtl/structs.v

accessor:
../rtl/accessor.v
../rtl/structs.v

pcloop:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/executor.v
../rtl/regsel.v
../rtl/structs.v
pcloop.sv

traps:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/executor.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

traps_pc:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/executor.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

traps_cause:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/executor.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

traps_status:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/executor.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

traps_quiescence:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/executor.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

busarbiter:
../rtl/busarbiter.v
busarbiter.sv

--
