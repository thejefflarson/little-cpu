[tasks]
executor all
decoder all

[options]
all: mode prove

[engines]
all: smtbmc

[script]
decoder:
read -sv -formal structs.v decoder.v
prep -top decoder

executor:
read -formal structs.v executor.v
prep -top executor
--
[files]
decoder:
../rtl/decoder.v
../rtl/structs.v

executor:
../rtl/executor.v
../rtl/structs.v

--
