[tasks]
executor all
decoder all
accessor all
pcloop all
traps all
busarbiter all

[options]
all: mode prove

[engines]
# No `all:` line: on a one-CPU pod it races a task's own engine, never replacing it.
decoder: smtbmc
accessor: smtbmc
traps: smtbmc
pcloop: smtbmc boolector
# executor is most of this job's clock; bitwuzla proves it in 101s against 245s.
executor: smtbmc bitwuzla

busarbiter: smtbmc --keep-going

[script]
decoder:
read -sv -formal structs.v decoder.v regsel.v
prep -top decoder

executor:
read -formal structs.v executor.v
prep -top executor

accessor:
read -sv -formal structs.v accessor.v
prep -top accessor

pcloop:
read -sv structs.v fetcher.v decoder.v regsel.v
read -sv -formal structs.v pcloop.sv
prep -top pcloop

traps:
# The same split as pcloop and for the same reason, drawn one statement finer.
read -sv -formal -noassume structs.v fetcher.v decoder.v regsel.v csrs.v
read -sv -formal structs.v traps.sv
prep -top traps

busarbiter:
read -sv -formal busarbiter.v busarbiter.sv
prep -top busarbiter_check
--
[files]
decoder:
../rtl/decoder.v
../rtl/regsel.v
../rtl/structs.v

executor:
../rtl/executor.v
../rtl/structs.v

accessor:
../rtl/accessor.v
../rtl/structs.v

pcloop:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/regsel.v
../rtl/structs.v
pcloop.sv

traps:
../rtl/fetcher.v
../rtl/decoder.v
../rtl/regsel.v
../rtl/csrs.v
../rtl/structs.v
traps.sv

busarbiter:
../rtl/busarbiter.v
busarbiter.sv

--
